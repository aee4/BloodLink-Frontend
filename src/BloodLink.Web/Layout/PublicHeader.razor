<header class="bl-public-header" @onkeydown="HandleKeyDown">
    <div class="bl-container bl-header-inner">
        <BloodLinkBrand />
        <nav class="bl-desktop-nav" aria-label="Primary navigation">
            <a href="/#how">How It Works</a>
            <a href="/#features">Features</a>
            <a href="/account/login">Facility Login</a>
        </nav>
        <div class="bl-header-actions">
            <a class="bl-btn bl-btn-outline bl-header-login" href="/account/login">Log In</a>
            <a class="bl-btn bl-btn-danger bl-header-register" href="/facility/register">Register Facility</a>
            <button type="button" class="bl-menu-toggle" aria-label="@(_menuOpen ? "Close navigation menu" : "Open navigation menu")"
                    aria-expanded="@(_menuOpen ? "true" : "false")" aria-controls="public-mobile-menu" @onclick="ToggleMenu">
                <AppIcon Name="@(_menuOpen ? "x" : "menu")" Size="21" />
            </button>
        </div>
    </div>
    <nav id="public-mobile-menu" class="bl-mobile-nav @(_menuOpen ? "is-open" : null)" aria-label="Mobile navigation" aria-hidden="@(_menuOpen ? "false" : "true")">
        <a href="/#how" @onclick="CloseMenu">How It Works</a>
        <a href="/#features" @onclick="CloseMenu">Features</a>
        <a href="/account/login" @onclick="CloseMenu">Facility Login</a>
        <a href="/facility/register" @onclick="CloseMenu">Register Facility</a>
    </nav>
</header>

@code {
    private bool _menuOpen;

    private void ToggleMenu() => _menuOpen = !_menuOpen;
    private void CloseMenu() => _menuOpen = false;
    private void HandleKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Escape") CloseMenu();
    }
}
