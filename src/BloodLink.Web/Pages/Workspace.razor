@page "/dashboard"
@page "/account/manage"
@page "/account/change-password"
@page "/facility/profile"
@page "/facility/staff"
@page "/facility/staff/create"
@page "/system/facilities"
@page "/system/facilities/{RecordId:guid}"
@page "/inventory"
@page "/inventory/adjust"
@page "/inventory/history"
@page "/inventory/search"
@page "/needs/new"
@page "/needs/mine"
@page "/needs"
@page "/needs/{RecordId:guid}"
@page "/requests/sent"
@page "/requests/received"
@page "/requests/{RecordId:guid}"
@page "/notifications"
@page "/access-denied"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject SessionStore Session
@inject AuthApiClient Auth
@inject FacilityApiClient Facilities
@inject StaffApiClient Staff
@inject InventoryApiClient Inventory
@inject NeedApiClient Needs
@inject RequestApiClient Requests
@inject NotificationApiClient Notifications
@inject DashboardApiClient Dashboard

<PageTitle>@Title | BloodLink</PageTitle>
<div class="bl-workspace-page">
    <header class="bl-page-header"><div><p class="bl-eyebrow">BloodLink workspace · @RoleLabel</p><h1>@Title</h1><p class="bl-page-description">@PageDescription</p></div><div class="bl-page-actions"><span class="bl-header-user"><span class="bl-sidebar-avatar">@UserInitials</span><span><strong>@Session.User?.FirstName @Session.User?.LastName</strong><small>@RoleLabel</small></span></span>@if (Path == "/inventory" && Session.User?.Roles.Contains("FacilityAdmin") == true) { <a class="bl-btn bl-btn-outline" href="/inventory/search"><AppIcon Name="search" Size="14" /> Network search</a><a class="bl-btn bl-btn-primary" href="/inventory/adjust"><AppIcon Name="package" Size="14" /> Adjust inventory</a> } else if (Path == "/inventory") { <a class="bl-btn bl-btn-outline" href="/inventory/history">History</a> } else if (Path == "/facility/staff") { <a class="bl-btn bl-btn-primary" href="/facility/staff/create">Create staff</a> }<button class="bl-icon-button" type="button" title="Refresh" aria-label="Refresh" @onclick="Load"><AppIcon Name="refresh-cw" Size="20" /></button></div></header>
    <Feedback Message="@Message" Variant="@Variant" />
    @if (ApiErrors.Count > 0)
    { <div class="bl-alert bl-alert-danger" role="alert"><ul>@foreach (var error in ApiErrors) { <li>@error.Key: @string.Join(" ", error.Value)</li> }</ul></div> }
    @if (ConfirmText is not null)
    {
        <div class="bl-modal-backdrop" @onclick="DismissConfirmation">
            <section class="bl-modal" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-description" tabindex="-1" @onclick:stopPropagation>
                <h2 id="confirm-title" class="bl-card-title">Confirm action</h2><p id="confirm-description" class="bl-card-desc">@ConfirmText</p>
                <div class="bl-confirm-actions"><button class="bl-btn bl-btn-outline" autofocus @onclick="DismissConfirmation">@CancelButtonText</button><button class="bl-btn bl-btn-danger" @onclick="ConfirmAction">@ConfirmButtonText</button></div>
            </section>
        </div>
    }
    @if (Busy) { <div class="bl-card bl-loading-state" role="status"><span class="bl-loading-dot"></span>Loading @Title.ToLowerInvariant()…</div> }
    @if (Path == "/access-denied")
    {
        <section class="bl-panel"><h2>Access denied</h2><p>Your account does not have permission to view this page.</p><a class="bl-button bl-button-primary" href="/dashboard">Return to dashboard</a></section>
    }
    else if (Path == "/account/manage")
    {
        <section class="bl-card bl-card-pad bl-record-detail"><p class="bl-eyebrow">Your account</p><h2 class="bl-card-title">Account details</h2>
            @if (Session.User?.MustChangePassword == true) { <div class="bl-alert bl-alert-info" role="status">Your administrator requires a password change before continuing. <a href="/account/change-password">Change password</a></div> }
            @if (Session.User?.FacilityStatus == FacilityStatus.Pending) { <div class="bl-alert bl-alert-info" role="status">This legacy facility registration is not active. Contact BloodLink support for assistance.</div> }
            @if (Session.User?.FacilityStatus == FacilityStatus.Suspended) { <div class="bl-alert bl-alert-danger" role="alert">This facility is suspended. Contact BloodLink support for assistance.</div> }
            @if (Session.User?.FacilityStatus == FacilityStatus.Rejected) { <div class="bl-alert bl-alert-danger" role="alert">This facility registration was rejected. Contact BloodLink support for assistance.</div> }
            <dl class="bl-facts"><div><dt>Name</dt><dd>@Session.User?.FirstName @Session.User?.LastName</dd></div><div><dt>Email</dt><dd>@Session.User?.Email</dd></div><div><dt>Role</dt><dd>@RoleLabel</dd></div>@if (Session.User?.FacilityStatus is FacilityStatus facilityStatus) { <div><dt>Facility access</dt><dd><span class="bl-status-badge @FacilityStatusClass(facilityStatus)">@FacilityStatusLabel(facilityStatus)</span></dd></div> }</dl>
            <div class="bl-form-actions"><a class="bl-btn bl-btn-outline" href="/account/change-password">Change password</a></div>
        </section>
    }
    else if (Path == "/account/change-password")
    {
        <section class="bl-card bl-card-pad bl-form-surface"><p class="bl-eyebrow">Account security</p><h2 class="bl-card-title">Change password</h2><p class="bl-card-desc">Choose a new password to protect your BloodLink account.</p><EditForm id="change-password-form" class="bl-form-grid" EditContext="PasswordEditContext" OnValidSubmit="ChangePassword" OnInvalidSubmit="InvalidPasswordSubmit" novalidate><DataAnnotationsValidator />
            @if (!string.IsNullOrWhiteSpace(Message)) { <div class="bl-validation-summary bl-field-full" role="alert">@Message</div> }
            <label class="bl-field"><span class="bl-label">Current password</span><InputText id="current-password" class="bl-input" type="password" autocomplete="current-password" aria-describedby="current-password-error" aria-invalid="@(HasPasswordError(nameof(PasswordForm.CurrentPassword)) ? "true" : "false")" @bind-Value="PasswordForm.CurrentPassword" /><InlineValidationMessage TValue="string" For="() => PasswordForm.CurrentPassword" Id="current-password-error" /></label>
            <label class="bl-field"><span class="bl-label">New password</span><PasswordInputText id="new-password" class="bl-input" type="password" autocomplete="new-password" aria-describedby="new-password-hint new-password-error" aria-invalid="@(HasPasswordError(nameof(PasswordForm.NewPassword)) ? "true" : "false")" @bind-Value="PasswordForm.NewPassword" /><InlineValidationMessage TValue="string" For="() => PasswordForm.NewPassword" Id="new-password-error" /></label>
            <div id="new-password-hint" class="bl-fieldset-help bl-field-full"><p>Password must contain:</p><PasswordRequirements Password="@PasswordForm.NewPassword" /></div>
            <label class="bl-field"><span class="bl-label">Confirm new password</span><InputText id="confirm-new-password" class="bl-input" type="password" autocomplete="new-password" aria-describedby="confirm-new-password-error" aria-invalid="@(HasPasswordError(nameof(PasswordForm.ConfirmPassword)) ? "true" : "false")" @bind-Value="PasswordForm.ConfirmPassword" /><InlineValidationMessage TValue="string" For="() => PasswordForm.ConfirmPassword" Id="confirm-new-password-error" /></label>
            <div class="bl-form-actions bl-field-full"><button class="bl-btn bl-btn-primary" type="submit" disabled="@Busy">Change password</button></div></EditForm></section>
    }
    else if (Path == "/facility/profile")
    {
        @if (Data is FacilityDto facility)
        {
            <section class="bl-panel"><dl><dt>Facility</dt><dd>@facility.Name</dd><dt>Status</dt><dd>@FacilityStatusLabel(facility.Status)</dd><dt>Registration</dt><dd>@facility.RegistrationNumber</dd></dl><EditForm id="facility-profile-form" class="bl-form-grid" EditContext="ProfileEditContext" OnValidSubmit="UpdateFacility" OnInvalidSubmit="InvalidProfileSubmit" novalidate><DataAnnotationsValidator />
                @if (!string.IsNullOrWhiteSpace(Message)) { <div class="bl-validation-summary bl-field-full" role="alert">@Message</div> }
                <label class="bl-field bl-field-full"><span class="bl-label">Address <span>*</span></span><InputText id="profile-address" class="bl-input" maxlength="500" aria-describedby="profile-address-error" aria-invalid="@(HasProfileError(nameof(ProfileForm.Address)) ? "true" : "false")" @bind-Value="ProfileForm.Address" /><InlineValidationMessage TValue="string" For="() => ProfileForm.Address" Id="profile-address-error" /></label>
                <label class="bl-field"><span class="bl-label">Contact email <span>*</span></span><InputText id="profile-contact-email" class="bl-input" type="email" maxlength="256" aria-describedby="profile-contact-email-error" aria-invalid="@(HasProfileError(nameof(ProfileForm.ContactEmail)) ? "true" : "false")" @bind-Value="ProfileForm.ContactEmail" /><InlineValidationMessage TValue="string" For="() => ProfileForm.ContactEmail" Id="profile-contact-email-error" /></label>
                <label class="bl-field"><span class="bl-label">Contact phone <span>*</span></span><InputText id="profile-contact-phone" class="bl-input" type="tel" maxlength="30" aria-describedby="profile-contact-phone-error" aria-invalid="@(HasProfileError(nameof(ProfileForm.ContactPhone)) ? "true" : "false")" @bind-Value="ProfileForm.ContactPhone" /><InlineValidationMessage TValue="string" For="() => ProfileForm.ContactPhone" Id="profile-contact-phone-error" /></label>
                <div class="bl-form-actions bl-field-full"><button class="bl-button bl-button-primary" type="submit" disabled="@Busy">Save profile</button></div></EditForm></section>
        }
    }
    else if (Path == "/facility/staff/create")
    {
        <section class="bl-panel"><h2>Staff account details</h2><p class="bl-card-desc">Create workspace access for a colleague at your facility.</p><EditForm id="staff-creation-form" class="bl-form-grid" EditContext="StaffEditContext" OnValidSubmit="CreateStaff" OnInvalidSubmit="InvalidStaffSubmit" novalidate><DataAnnotationsValidator />
            @if (!string.IsNullOrWhiteSpace(Message)) { <div class="bl-validation-summary bl-field-full" role="alert">@Message</div> }
            <label class="bl-field"><span class="bl-label">First name <span>*</span></span><InputText id="staff-first-name" class="bl-input" maxlength="100" aria-describedby="staff-first-name-error" aria-invalid="@(HasStaffError(nameof(StaffForm.FirstName)) ? "true" : "false")" @bind-Value="StaffForm.FirstName" /><InlineValidationMessage TValue="string" For="() => StaffForm.FirstName" Id="staff-first-name-error" /></label>
            <label class="bl-field"><span class="bl-label">Last name <span>*</span></span><InputText id="staff-last-name" class="bl-input" maxlength="100" aria-describedby="staff-last-name-error" aria-invalid="@(HasStaffError(nameof(StaffForm.LastName)) ? "true" : "false")" @bind-Value="StaffForm.LastName" /><InlineValidationMessage TValue="string" For="() => StaffForm.LastName" Id="staff-last-name-error" /></label>
            <label class="bl-field"><span class="bl-label">Email <span>*</span></span><InputText id="staff-email" class="bl-input" type="email" maxlength="256" aria-describedby="staff-email-error" aria-invalid="@(HasStaffError(nameof(StaffForm.Email)) ? "true" : "false")" @bind-Value="StaffForm.Email" /><InlineValidationMessage TValue="string" For="() => StaffForm.Email" Id="staff-email-error" /></label>
            <label class="bl-field"><span class="bl-label">Phone</span><InputText id="staff-phone" class="bl-input" type="tel" maxlength="30" aria-describedby="staff-phone-error" aria-invalid="@(HasStaffError(nameof(StaffForm.PhoneNumber)) ? "true" : "false")" @bind-Value="StaffForm.PhoneNumber" /><InlineValidationMessage TValue="string" For="() => StaffForm.PhoneNumber" Id="staff-phone-error" /></label>
            <label class="bl-field"><span class="bl-label">Temporary password <span>*</span></span><PasswordInputText id="staff-password" class="bl-input" type="password" autocomplete="new-password" aria-describedby="staff-pass-note staff-password-error" aria-invalid="@(HasStaffError(nameof(StaffForm.Password)) ? "true" : "false")" @bind-Value="StaffForm.Password" /><InlineValidationMessage TValue="string" For="() => StaffForm.Password" Id="staff-password-error" /></label>
            <div id="staff-pass-note" class="bl-fieldset-help"><p>Password must contain:</p><PasswordRequirements Password="@StaffForm.Password" /><p>Share credentials securely. Password-reset delivery is unavailable.</p></div>
            <button class="bl-button bl-button-primary bl-field-full" type="submit" disabled="@Busy">Create staff account</button></EditForm></section>
    }
    else if (Path == "/inventory/adjust")
    {
        <section class="bl-panel"><h2>Record a stock adjustment</h2><p class="bl-card-desc">Keep your facility inventory current. Include a reason for the adjustment.</p><form @onsubmit="AdjustInventory" @onsubmit:preventDefault><label>Blood type<InputSelect @bind-Value="SelectedBloodType"><option value="APositive">A+</option><option value="ANegative">A-</option><option value="BPositive">B+</option><option value="BNegative">B-</option><option value="ABPositive">AB+</option><option value="ABNegative">AB-</option><option value="OPositive">O+</option><option value="ONegative">O-</option></InputSelect></label><label>Change in total units<input type="number" required @bind="UnitsChange" /></label><label>Reason<input required maxlength="500" @bind="Reason" /></label><button class="bl-button bl-button-primary" disabled="@Busy">Adjust inventory</button></form></section>
    }
    else if (Path == "/inventory/search")
    {
        <section class="bl-panel"><h2>Search the facility network</h2><p class="bl-card-desc">Find available units by blood type and minimum quantity.</p><form @onsubmit="SearchInventory" @onsubmit:preventDefault><label>Blood type<InputSelect @bind-Value="SelectedBloodType"><option value="APositive">A+</option><option value="ANegative">A-</option><option value="BPositive">B+</option><option value="BNegative">B-</option><option value="ABPositive">AB+</option><option value="ABNegative">AB-</option><option value="OPositive">O+</option><option value="ONegative">O-</option></InputSelect></label><label>Minimum available<input type="number" min="1" @bind="MinimumAvailable" /></label><button class="bl-button bl-button-primary">Search facilities</button></form></section>
    }
    else if (Path == "/needs/new")
    {
        <section class="bl-panel"><h2>Blood need details</h2><p class="bl-card-desc">Specify the blood type, quantity, urgency, and time your facility needs stock.</p><form @onsubmit="CreateNeed" @onsubmit:preventDefault><label>Blood type<InputSelect @bind-Value="SelectedBloodType"><option value="APositive">A+</option><option value="ANegative">A-</option><option value="BPositive">B+</option><option value="BNegative">B-</option><option value="ABPositive">AB+</option><option value="ABNegative">AB-</option><option value="OPositive">O+</option><option value="ONegative">O-</option></InputSelect></label><label>Units needed<input type="number" min="1" max="10000" required @bind="NeedUnits" /></label><label>Urgency<InputSelect @bind-Value="SelectedUrgency"><option value="Routine">Routine</option><option value="Urgent">Urgent</option><option value="Emergency">Emergency</option></InputSelect></label><label>Needed by (your local time)<input id="needed-by" type="datetime-local" required aria-describedby="needed-by-error" @bind="NeededByLocal" @bind:after="ClearDeadlineError" /></label>@if (DeadlineError) { <p id="needed-by-error" class="bl-field-error" role="alert">Needed-by time must be in the future.</p> }<label>Note<textarea maxlength="1000" @bind="Note"></textarea></label><button class="bl-button bl-button-primary" disabled="@Busy">Submit need</button></form></section>
    }
    else if (Path == "/facility/staff")
    { <p class="bl-card-desc">Manage access for the people working at your facility.</p> }
    else if (Path == "/requests/sent" || Path == "/requests/received")
    {
        @if (Path == "/requests/sent")
        {
            @if (RequestNeed is { Status: BloodNeedStatus.Searching } requestNeed)
            {
                <section class="bl-panel"><h2>Request an external source</h2><p>@requestNeed.BloodType · @requestNeed.UnitsNeeded units needed · @requestNeed.Urgency</p>
                    @if (RequestSources.Count == 0) { <p>No other approved facility currently has matching available inventory.</p> }
                    else { <form @onsubmit="CreateRequest" @onsubmit:preventDefault><label>Units requested<input type="number" required min="1" max="@requestNeed.UnitsNeeded" @bind="RequestUnits" @bind:after="SearchRequestSources" /></label><label>Source facility<InputSelect required @bind-Value="SourceFacilityText">@foreach (var source in RequestSources) { <option value="@source.FacilityId">@source.FacilityName · @source.City · @source.AvailableUnits available</option> }</InputSelect></label><label>Note<input maxlength="1000" @bind="RequestNoteText" /></label><button class="bl-button bl-button-primary" disabled="@Busy">Send request</button></form> }
                </section>
            }
            else if (string.IsNullOrWhiteSpace(NeedIdText))
            { <section class="bl-panel"><p>Start external requests from a searching need.</p><a class="bl-button bl-button-primary" href="/needs">Open facility needs</a></section> }
            else if (RequestNeed is not null)
            { <Feedback Message="External requests can only be created from a need in Searching status." Variant="info" /> }
        }
    }
    else if (Path == "/system/facilities" && Session.User?.Roles.Contains("SystemAdmin") == true)
    {
        <section class="bl-toolbar"><label>Filter status<InputSelect TValue="int?" Value="@FacilityStatusFilter" ValueChanged="ChangeFacilityStatusFilter" ValueExpression="@(() => FacilityStatusFilter)"><option value="">All</option><option value="1">Active</option><option value="3">Suspended</option><option value="0">Legacy pending</option><option value="2">Rejected (legacy)</option></InputSelect></label></section>
    }
    @if (Data is not null)
    {
        if (Path == "/dashboard" && Data is System.Text.Json.JsonElement dashboardData)
        {
            <DashboardOverview Data="dashboardData" />
        }
        else
        {
        @if (Path == "/notifications")
        { <div class="bl-actions"><button class="bl-btn bl-btn-outline" @onclick="MarkAllNotificationsRead">Mark all as read</button></div> }
        @if (Path == "/system/facilities/" + CurrentId)
        {
            <section class="bl-panel"><div class="bl-actions">@if (Data is FacilityDto approved && approved.Status == FacilityStatus.Approved) { <label>Suspension reason<textarea @bind="Reason"></textarea></label><button class="bl-btn bl-btn-danger" @onclick="SuspendFacility">Suspend</button> }@if (Data is FacilityDto suspended && suspended.Status == FacilityStatus.Suspended) { <button class="bl-button bl-button-primary" @onclick="RestoreFacility">Unsuspend</button> }</div></section>
        }
        @if (Path.StartsWith("/needs/") && CurrentId is not null && Path != "/needs/new")
        {
            @if (Data is NeedDetailDto detail)
            {
                var isAdmin = Session.User?.Roles.Contains("FacilityAdmin") == true;
                var isCreator = string.Equals(detail.CreatorDisplayName, $"{Session.User?.FirstName} {Session.User?.LastName}".Trim(), StringComparison.OrdinalIgnoreCase);
                var canCancel = detail.Status is BloodNeedStatus.PendingReview or BloodNeedStatus.Searching && isAdmin
                    || detail.Status == BloodNeedStatus.PendingReview && isCreator;
                <section class="bl-card bl-card-pad bl-workflow-actions" aria-labelledby="need-actions-title">
                    <h2 id="need-actions-title" class="bl-card-title">Need actions</h2>
                    <label class="bl-field"><span class="bl-label">Decision note</span><textarea class="bl-input bl-textarea" @bind="Reason" maxlength="1000"></textarea></label>
                    <div class="bl-actions">
                        @if (isAdmin && detail.Status == BloodNeedStatus.PendingReview) { <button class="bl-btn bl-btn-outline" @onclick="StartNeedSearch">Start network search</button> }
                        @if (isAdmin && detail.Status is BloodNeedStatus.PendingReview or BloodNeedStatus.Searching) { <button class="bl-btn bl-btn-primary" @onclick="FulfilNeed">Fulfil internally</button> }
                        @if (isAdmin && detail.Status == BloodNeedStatus.PendingReview) { <button class="bl-btn bl-btn-danger" @onclick="RejectNeed">Reject</button> }
                        @if (isAdmin && detail.Status == BloodNeedStatus.Searching) { <a class="bl-btn bl-btn-outline" href="@($"/requests/sent?needId={CurrentId}")">Request externally</a> }
                        @if (canCancel) { <button class="bl-btn bl-btn-outline" @onclick="CancelNeed">Cancel need</button> }
                    </div>
                </section>
            }
        }
        @if (Path != "/dashboard")
        {
            @if (Data is RequestDto request)
            {
                <div class="bl-request-detail-flow"><OperationalRecords Data="request" RequestSourceAvailable="RequestSourceAvailable" RequestNeededBy="@RequestNeed?.NeededByUtc" RequestNeedNote="@RequestNeed?.Note" /><div class="bl-request-actions-slot">@if (Session.User?.FacilityId == request.SourceFacilityId && Session.User?.Roles.Contains("FacilityAdmin") == true) { <RequestWorkflowActions Request="request" Available="RequestSourceAvailable" Busy="Busy" Accept="AcceptRequest" Reject="RejectRequest" Cancel="CancelRequest" Handover="ConfirmHandover" @bind-Reason="Reason" /> }</div></div>
                @if (TimelineData is not null) { <OperationalRecords Data="TimelineData" /> }
            }
            else if (TimelineData is not null)
            {
                <div class="bl-detail-grid"><div class="bl-detail-main"><OperationalRecords Data="Data" RequestSourceAvailable="RequestSourceAvailable" IsReceivedRequestList="@(Path == "/requests/received")" IsFacilityAdmin="@(Session.User?.Roles.Contains("FacilityAdmin") == true)" LowStock="LowStockItems" /></div><aside class="bl-detail-aside"><OperationalRecords Data="TimelineData" /></aside></div>
            }
            else
            {
                <OperationalRecords Data="Data" StaffAction="ChangeStaff" NotificationRead="MarkNotificationReadId" PageChanged="ChangePage" RequestSourceAvailable="RequestSourceAvailable" IsReceivedRequestList="@(Path == "/requests/received")" IsFacilityAdmin="@(Session.User?.Roles.Contains("FacilityAdmin") == true)" LowStock="LowStockItems" />
            }
        }
        }
    }
</div>

@code {
    [Parameter] public Guid? RecordId { get; set; }
    private string Path => "/" + Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
    private string RoleLabel => Session.User?.Roles.Contains("SystemAdmin") == true ? "System Admin" : Session.User?.Roles.Contains("FacilityAdmin") == true ? "Facility Admin" : "Facility Staff";
    private string UserInitials => $"{(Session.User?.FirstName ?? "B").FirstOrDefault()}{(Session.User?.LastName ?? "L").FirstOrDefault()}".ToUpperInvariant();
    private string Title => Path switch { "/dashboard" => "Dashboard", "/account/manage" => "Account", "/account/change-password" => "Change password", "/facility/profile" => "Facility profile", "/facility/staff" or "/facility/staff/create" => "Staff", "/system/facilities" => "Facility governance", "/inventory/adjust" => "Adjust inventory", "/inventory/history" => "Inventory history", "/inventory/search" => "Find blood availability", "/inventory" => "Inventory", "/needs/new" => "Submit a need", "/needs/mine" => "My needs", "/needs" => "Facility needs", "/requests/sent" => "Requests sent", "/requests/received" => "Requests received", "/notifications" => "Notifications", "/access-denied" => "Access denied", _ when Path.StartsWith("/system/facilities/") => "Facility governance", _ when Path.StartsWith("/needs/") => "Need details", _ when Path.StartsWith("/requests/") => "Request details", _ => "BloodLink" };
    private string PageDescription => Path switch
    {
        "/dashboard" => $"Welcome back, {Session.User?.FirstName}. Here is your workspace at a glance.",
        "/inventory" => "Current stock, reservations, and availability by blood type.",
        "/inventory/history" => "Review recorded stock changes and their context.",
        "/inventory/adjust" => "Record a change to your facility's blood stock.",
        "/inventory/search" => "Find matching blood stock across the facility network.",
        "/needs" or "/needs/mine" => "Track blood needs, review progress, and follow decisions.",
        "/needs/new" => "Submit a blood need for your facility.",
        "/requests/sent" => "Follow the requests your facility has sent to other teams.",
        "/requests/received" => "Review incoming requests and coordinate your response.",
        "/notifications" => "Updates on facility needs, requests, and workspace activity.",
        "/facility/profile" => "Your facility identity and contact information.",
        "/facility/staff" or "/facility/staff/create" => "Manage your facility team's workspace access.",
        "/account/manage" or "/account/change-password" => "Manage your account information and security.",
        _ when Path.StartsWith("/system/facilities") => "Platform administration: facility access and registration records.",
        _ when Path.StartsWith("/needs/") => "Review this need, available actions, and status history.",
        _ when Path.StartsWith("/requests/") => "Review request context, available actions, and handover progress.",
        _ => "BloodLink facility workspace."
    };
    private object? Data { get; set; }
    private object? TimelineData { get; set; }
    private IReadOnlyList<LowStockDto> LowStockItems { get; set; } = [];
    private int PageNumber { get; set; } = 1;
    private List<Dictionary<string, string>> Rows { get; set; } = [];
    private List<Dictionary<string, string>> TimelineRows { get; set; } = [];
    private string? Message { get; set; }
    private string Variant { get; set; } = "danger";
    private IReadOnlyDictionary<string, string[]> ApiErrors { get; set; } = new Dictionary<string, string[]>();
    private readonly StaffCreationForm StaffForm = new();
    private readonly ChangePasswordForm PasswordForm = new();
    private readonly FacilityProfileForm ProfileForm = new();
    private EditContext StaffEditContext { get; set; } = default!;
    private EditContext PasswordEditContext { get; set; } = default!;
    private EditContext ProfileEditContext { get; set; } = default!;
    private ValidationMessageStore StaffServerMessages { get; set; } = default!;
    private ValidationMessageStore PasswordServerMessages { get; set; } = default!;
    private ValidationMessageStore ProfileServerMessages { get; set; } = default!;
    private string? ConfirmText { get; set; }
    private string ConfirmButtonText { get; set; } = "Continue";
    private string CancelButtonText { get; set; } = "Cancel";
    private Func<Task>? PendingConfirmation { get; set; }
    private bool Busy { get; set; } = true;
    private long loadGeneration;
    private BloodType SelectedBloodType { get; set; } private UrgencyLevel SelectedUrgency { get; set; }
    private int UnitsChange { get; set; } private int MinimumAvailable { get; set; } = 1; private int NeedUnits { get; set; } = 1; private int RequestUnits { get; set; } = 1;
    private int? FacilityStatusFilter { get; set; } = (int)FacilityStatus.Approved; private string Reason { get; set; } = ""; private string Note { get; set; } = ""; private string RequestNoteText { get; set; } = "";
    private string NeedIdText { get; set; } = ""; private string SourceFacilityText { get; set; } = ""; private DateTime NeededByLocal { get; set; } = DateTime.Now.AddHours(1); private bool DeadlineError { get; set; }
    private NeedDetailDto? RequestNeed { get; set; }
    private int? RequestSourceAvailable { get; set; }
    private List<AvailabilityDto> RequestSources { get; set; } = [];

    private string? loadedRouteKey;
    private string RouteKey => Path + new Uri(Navigation.Uri).Query;

    protected override void OnInitialized()
    {
        StaffEditContext = new EditContext(StaffForm);
        StaffServerMessages = new ValidationMessageStore(StaffEditContext);
        StaffEditContext.OnFieldChanged += (_, args) => FormValidation.ClearServerError(StaffEditContext, StaffServerMessages, args);

        PasswordEditContext = new EditContext(PasswordForm);
        PasswordServerMessages = new ValidationMessageStore(PasswordEditContext);
        PasswordEditContext.OnFieldChanged += (_, args) => FormValidation.ClearServerError(PasswordEditContext, PasswordServerMessages, args);

        ProfileEditContext = new EditContext(ProfileForm);
        ProfileServerMessages = new ValidationMessageStore(ProfileEditContext);
        ProfileEditContext.OnFieldChanged += (_, args) => FormValidation.ClearServerError(ProfileEditContext, ProfileServerMessages, args);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (loadedRouteKey == RouteKey) return;
        loadedRouteKey = RouteKey;
        Data = null; TimelineData = null; Rows = []; TimelineRows = []; PageNumber = 1; Message = null;
        await SetRouteState();
        await Load();
        StateHasChanged();
    }

    private async Task SetRouteState()
    {
        var query = new Uri(Navigation.Uri).Query.TrimStart('?');
        NeedIdText = query.Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .Where(parts => parts.Length == 2 && Uri.UnescapeDataString(parts[0]).Equals("needId", StringComparison.OrdinalIgnoreCase))
            .Select(parts => Uri.UnescapeDataString(parts[1]))
            .FirstOrDefault() ?? "";
        if (Path == "/needs/new")
        {
            var localValue = await JS.InvokeAsync<string>("bloodLinkNeedDeadline.defaultLocalValue");
            NeededByLocal = DateTime.Parse(localValue, System.Globalization.CultureInfo.InvariantCulture);
        }
    }

    private async Task Load()
    {
        var generation = Interlocked.Increment(ref loadGeneration);
        Busy = true; Message = null; ApiErrors = new Dictionary<string, string[]>(); Data = null; TimelineData = null; LowStockItems = []; RequestSourceAvailable = null; Rows = []; TimelineRows = []; RequestNeed = null; RequestSources = [];
        try
        {
            if (!CanAccessPath()) { Message = "Your account does not have permission to view this page."; Variant = "danger"; return; }
            object? loadedData = Path switch
            {
                "/dashboard" => await Dashboard.GetDashboard(),
                "/facility/profile" => await Facilities.Mine(),
                "/facility/staff" => await Staff.List(PageNumber),
                "/inventory" => await Inventory.List(),
                "/inventory/history" => await Inventory.History(PageNumber),
                "/inventory/search" => null,
                "/needs/mine" => await Needs.Mine(PageNumber),
                "/needs" => await Needs.List(PageNumber),
                "/requests/sent" => await Requests.Sent(PageNumber),
                "/requests/received" => await Requests.Received(PageNumber),
                "/notifications" => await Notifications.List(PageNumber),
                "/system/facilities" => await Facilities.SystemList(FacilityStatusFilter, PageNumber),
                _ when Path.StartsWith("/system/facilities/") && CurrentId is Guid id => await Facilities.SystemGet(id),
                _ when Path.StartsWith("/needs/") && CurrentId is Guid id => await Needs.Get(id),
                _ when Path.StartsWith("/requests/") && CurrentId is Guid id => await Requests.Get(id),
                _ => null
            };
            if (generation != Volatile.Read(ref loadGeneration)) return;
            Data = loadedData;
            if (Data is not null) Rows = ToRows(Data);
            if (Path == "/inventory" && Session.User?.Roles.Contains("FacilityAdmin") == true) LowStockItems = await Inventory.LowStock();
            if (Data is FacilityDto facility) { ProfileForm.Address = facility.Address; ProfileForm.ContactEmail = facility.ContactEmail; ProfileForm.ContactPhone = facility.ContactPhone; ProfileEditContext.NotifyValidationStateChanged(); }
            if (Data is RequestDto currentRequest)
            {
                if (currentRequest.RequestingFacilityId == Session.User?.FacilityId)
                {
                    try { RequestNeed = await Needs.Get(currentRequest.BloodNeedId); } catch (ApiException) { }
                }
                try
                {
                    RequestSourceAvailable = Session.User?.FacilityId == currentRequest.SourceFacilityId
                        ? (await Inventory.List()).FirstOrDefault(item => item.BloodType == currentRequest.BloodType)?.AvailableUnits
                        : (await Inventory.Search(currentRequest.BloodType, 1)).Items.FirstOrDefault(item => item.FacilityId == currentRequest.SourceFacilityId)?.AvailableUnits;
                }
                catch (ApiException) { }
            }
            if (Path == "/requests/sent" && Guid.TryParse(NeedIdText, out var linkedNeedId))
            {
                RequestNeed = await Needs.Get(linkedNeedId);
                if (RequestNeed.Status == BloodNeedStatus.Searching) await SearchRequestSources();
            }
            if (CurrentId is Guid record && Session.User?.Roles.Contains("FacilityAdmin") == true && Path.StartsWith("/needs/")) TimelineData = await Needs.Timeline(record);
            if (CurrentId is Guid requestId && Session.User?.Roles.Contains("FacilityAdmin") == true && Path.StartsWith("/requests/")) TimelineData = await Requests.Timeline(requestId);
        }
        catch (ApiException ex)
        {
            if (generation == Volatile.Read(ref loadGeneration)) { Message = ex.Message; ApiErrors = ex.Fields; }
        }
        finally
        {
            if (generation == Volatile.Read(ref loadGeneration)) Busy = false;
        }
    }
    private async Task ChangeFacilityStatusFilter(int? status)
    {
        FacilityStatusFilter = status;
        PageNumber = 1;
        await Load();
    }
    private Task ClearDeadlineError() { DeadlineError = false; return Task.CompletedTask; }
    private async Task ChangePage(int page) { PageNumber = Math.Max(1, page); await Load(); }
    private async Task Run(Func<Task> action, string success)
    {
        Busy = true; Message = null; ApiErrors = new Dictionary<string, string[]>();
        try { await action(); await Load(); Variant = "success"; Message = success; }
        catch (ApiException ex) { Variant = "danger"; Message = ex.Message; ApiErrors = ex.Fields; }
        finally { Busy = false; }
    }
    private async Task CreateNeed()
    {
        var utc = await JS.InvokeAsync<string?>("bloodLinkNeedDeadline.toUtcIfFuture", "needed-by");
        if (utc is null) { DeadlineError = true; return; }
        DeadlineError = false;
        await Run(async () => { var created = await Needs.Create(new(SelectedBloodType, NeedUnits, SelectedUrgency, DateTime.Parse(utc, null, System.Globalization.DateTimeStyles.RoundtripKind), Note)); Navigation.NavigateTo($"/needs/{created.Id}"); }, "Need submitted.");
    }
    private async Task UpdateFacility()
    {
        if (Busy) return;
        Busy = true;
        Message = null;
        ProfileServerMessages.Clear();
        try
        {
            await Facilities.Update(new(ProfileForm.Address, ProfileForm.ContactEmail, ProfileForm.ContactPhone));
            await Load();
            Variant = "success";
            Message = "Facility profile saved.";
        }
        catch (ApiException ex)
        {
            var mapped = FormValidation.ApplyServerErrors(ProfileEditContext, ProfileServerMessages, ex.Fields);
            Message = mapped ? "Review the marked fields and correct their values." : ex.Message;
            if (mapped) await FocusFirstInvalid("facility-profile-form");
        }
        finally { Busy = false; }
    }

    private Task InvalidProfileSubmit(EditContext _) { Message = "Correct the highlighted fields before submitting."; return FocusFirstInvalid("facility-profile-form"); }
    private async Task ChangePassword()
    {
        if (Busy) return;
        Busy = true;
        Message = null;
        PasswordServerMessages.Clear();
        try
        {
            await Auth.ChangePassword(PasswordForm.CurrentPassword, PasswordForm.NewPassword);
            PasswordForm.CurrentPassword = PasswordForm.NewPassword = PasswordForm.ConfirmPassword = "";
            Navigation.NavigateTo("/account/login?signedOut=true", new NavigationOptions { ReplaceHistoryEntry = true });
        }
        catch (ApiException ex)
        {
            var mapped = FormValidation.ApplyServerErrors(PasswordEditContext, PasswordServerMessages, ex.Fields);
            Message = mapped ? "Review the marked fields and correct their values." : ex.Message;
            if (mapped) await FocusFirstInvalid("change-password-form");
        }
        finally { Busy = false; }
    }

    private async Task CreateStaff()
    {
        if (Busy) return;
        Busy = true;
        Message = null;
        ApiErrors = new Dictionary<string, string[]>();
        StaffServerMessages.Clear();
        try
        {
            await Staff.Create(new(StaffForm.FirstName, StaffForm.LastName, StaffForm.Email, StaffForm.PhoneNumber, StaffForm.Password));
            StaffForm.Password = "";
            Navigation.NavigateTo("/facility/staff");
        }
        catch (ApiException ex)
        {
            var mapped = FormValidation.ApplyServerErrors(StaffEditContext, StaffServerMessages, ex.Fields);
            Message = mapped ? "Review the marked fields and correct their values." : ex.Message;
            if (mapped) await FocusFirstInvalid("staff-creation-form");
        }
        finally { Busy = false; }
    }

    private Task InvalidStaffSubmit(EditContext _)
    {
        Message = "Correct the highlighted fields before submitting.";
        return FocusFirstInvalid("staff-creation-form");
    }

    private Task InvalidPasswordSubmit(EditContext _)
    {
        Message = "Correct the highlighted fields before submitting.";
        return FocusFirstInvalid("change-password-form");
    }

    private bool HasStaffError(string field) => StaffEditContext?.GetValidationMessages(new FieldIdentifier(StaffForm, field)).Any() == true;
    private bool HasPasswordError(string field) => PasswordEditContext?.GetValidationMessages(new FieldIdentifier(PasswordForm, field)).Any() == true;
    private bool HasProfileError(string field) => ProfileEditContext?.GetValidationMessages(new FieldIdentifier(ProfileForm, field)).Any() == true;
    private Task FocusFirstInvalid(string formId) => JS.InvokeVoidAsync("bloodLinkValidation.focusFirstInvalid", formId).AsTask();
    private Task AdjustInventory() => Run(() => Inventory.Adjust(new(SelectedBloodType, UnitsChange, Reason, null)), "Inventory adjustment saved.");
    private async Task SearchInventory() { try { Data = await Inventory.Search(SelectedBloodType, MinimumAvailable); Rows = ToRows(Data); } catch (ApiException ex) { Message = ex.Message; } }
    private Task CreateRequest() => Guid.TryParse(NeedIdText, out var needId) && Guid.TryParse(SourceFacilityText, out var facilityId) ? Run(async () => { var created = await Requests.Create(new(needId, facilityId, RequestUnits, RequestNoteText)); Navigation.NavigateTo($"/requests/{created.Id}"); }, "Request sent.") : SetMessage("Enter valid need and source facility IDs.");
    private async Task SearchRequestSources()
    {
        if (RequestNeed is null) return;
        var results = await Inventory.Search(RequestNeed.BloodType, RequestUnits);
        RequestSources = results.Items.Where(source => source.FacilityId != Session.User?.FacilityId).ToList();
        if (!RequestSources.Any(source => source.FacilityId.ToString() == SourceFacilityText))
            SourceFacilityText = RequestSources.FirstOrDefault()?.FacilityId.ToString() ?? "";
    }
    private Task SuspendFacility() => AskConfirmation("Suspend this facility? Its users will lose operational access.", () => Run(() => Facilities.Suspend(CurrentId!.Value, Reason), "Facility suspended."));
    private Task RestoreFacility() => Run(() => Facilities.Restore(CurrentId!.Value), "Facility unsuspended.");
    private Task StartNeedSearch() => Run(() => Needs.StartSearch(CurrentId!.Value), "Need search started.");
    private Task FulfilNeed() => Run(() => Needs.Fulfil(CurrentId!.Value, Reason), "Need fulfilled internally.");
    private Task RejectNeed() => AskConfirmation("Reject this blood need?", () => Run(() => Needs.Reject(CurrentId!.Value, Reason), "Need rejected."));
    private Task CancelNeed() => AskConfirmation("Cancel this blood need?", () => Run(() => Needs.Cancel(CurrentId!.Value, Reason), "Need cancelled."));
    // Full-request-only acceptance prevents the known backend behavior where partial fulfillment can close the entire linked need.
    private Task AcceptRequest()
    {
        if (Busy || Data is not RequestDto request || request.Status != BloodRequestStatus.Sent || !RequestAcceptancePolicy.CanAcceptFullRequest(request.UnitsRequested, RequestSourceAvailable))
            return SetMessage("Your facility needs enough available stock to accept the full request.");
        return Run(() => Requests.Accept(CurrentId!.Value, request.UnitsRequested, null), "Full request accepted and units reserved.");
    }
    private Task RejectRequest() => Busy || Data is not RequestDto request || request.Status != BloodRequestStatus.Sent || string.IsNullOrWhiteSpace(Reason)
        ? SetMessage("Enter a rejection reason before rejecting this request.")
        : Run(() => Requests.Reject(CurrentId!.Value, Reason.Trim()), "Request rejected.");
    private Task CancelRequest() => Data is not RequestDto request ? Task.CompletedTask : AskConfirmation(
        request.Status == BloodRequestStatus.Accepted ? "Cancel this Accepted request? Its reserved units will be released." : "Cancel this Sent request? It will be closed.",
        () => Run(() => Requests.Cancel(CurrentId!.Value), "Request cancelled."));
    private Task ConfirmHandover() => Data is not RequestDto request || request.Status != BloodRequestStatus.Accepted ? Task.CompletedTask : AskConfirmation(
        $"Confirm physical handover of {request.UnitsAccepted ?? 0} units of {BloodTypeLabel(request.BloodType)} to {request.RequestingFacilityName}? Source inventory will decrease and requesting facility inventory will increase.",
        () => Run(() => Requests.Fulfil(CurrentId!.Value, null), "Handover confirmed. Request fulfilled and inventory transferred."), "Confirm handover", "Go back");
    private async Task ChangeStaff(Dictionary<string, string> row)
    {
        var userId = row.GetValueOrDefault("UserId");
        if (string.IsNullOrWhiteSpace(userId)) return;
        var active = row.GetValueOrDefault("Status") == "Active";
        var operation = () => Run(() => active ? Staff.Deactivate(userId, "Deactivated by facility administrator.") : Staff.Activate(userId), active ? "Staff account deactivated." : "Staff account activated.");
        if (active) await AskConfirmation($"Deactivate {row.GetValueOrDefault("FullName")}? They will no longer be able to sign in.", operation);
        else await operation();
    }
    private async Task ChangeStaff(StaffDto staff)
    {
        var operation = () => Run(() => staff.Status == StaffStatus.Active
            ? Staff.Deactivate(staff.UserId, "Deactivated by facility administrator.")
            : Staff.Activate(staff.UserId), staff.Status == StaffStatus.Active ? "Staff account deactivated." : "Staff account activated.");
        if (staff.Status == StaffStatus.Active)
            await AskConfirmation($"Deactivate {staff.FullName}? They will no longer be able to sign in.", operation);
        else
            await operation();
    }
    private Task MarkNotificationRead(Dictionary<string, string> row) => Guid.TryParse(row.GetValueOrDefault("Id"), out var id) ? Run(() => Notifications.MarkRead(id), "Notification marked as read.") : Task.CompletedTask;
    private Task MarkNotificationReadId(Guid id) => Run(() => Notifications.MarkRead(id), "Notification marked as read.");
    private Task MarkAllNotificationsRead() => Run(() => Notifications.MarkAllRead(), "Notifications marked as read.");
    private string? LinkForRecord(Guid id) => Path.StartsWith("/needs") ? $"/needs/{id}" : Path.StartsWith("/requests") ? $"/requests/{id}" : Path.StartsWith("/system/facilities") ? $"/system/facilities/{id}" : null;
    private static string FacilityStatusClass(FacilityStatus status) => status switch { FacilityStatus.Approved => "bl-status-success", FacilityStatus.Pending => "bl-status-neutral", _ => "bl-status-danger" };
    private static string FacilityStatusLabel(FacilityStatus status) => status switch { FacilityStatus.Approved => "Active", FacilityStatus.Pending => "Legacy pending", FacilityStatus.Rejected => "Rejected (legacy)", FacilityStatus.Suspended => "Suspended", _ => "Unknown" };
    private Guid? CurrentId => Guid.TryParse(Path.Split('/').Last(), out var id) ? id : null;
    private bool CanAccessPath()
    {
        var roles = Session.User?.Roles ?? Array.Empty<string>();
        if (Path.StartsWith("/system/facilities")) return roles.Contains("SystemAdmin");
        if (Path == "/facility/profile" || Path.StartsWith("/facility/staff") || Path == "/inventory/adjust" || Path == "/inventory/history" || Path == "/needs" || Path.StartsWith("/requests/")) return roles.Contains("FacilityAdmin");
        if (Path == "/inventory/search") return roles.Contains("FacilityAdmin");
        if (Path == "/inventory") return roles.Contains("FacilityAdmin") || roles.Contains("FacilityStaff");
        if (Path == "/notifications") return roles.Contains("FacilityAdmin") || roles.Contains("FacilityStaff");
        if (Path == "/needs/new" || Path == "/needs/mine") return roles.Contains("FacilityStaff") || roles.Contains("FacilityAdmin");
        return roles.Contains("SystemAdmin") || roles.Contains("FacilityAdmin") || roles.Contains("FacilityStaff");
    }
    private Task SetMessage(string text) { Message = text; return Task.CompletedTask; }
    private static string BloodTypeLabel(BloodType type) => type switch { BloodType.APositive => "A+", BloodType.ANegative => "A-", BloodType.BPositive => "B+", BloodType.BNegative => "B-", BloodType.ABPositive => "AB+", BloodType.ABNegative => "AB-", BloodType.OPositive => "O+", _ => "O-" };
    private Task AskConfirmation(string text, Func<Task> action, string confirmButton = "Continue", string cancelButton = "Cancel") { ConfirmText = text; PendingConfirmation = action; ConfirmButtonText = confirmButton; CancelButtonText = cancelButton; return Task.CompletedTask; }
    private async Task ConfirmAction()
    {
        var action = PendingConfirmation; ConfirmText = null; PendingConfirmation = null;
        if (action is not null) await action();
    }
    private Task DismissConfirmation() { ConfirmText = null; PendingConfirmation = null; return Task.CompletedTask; }
    private static List<Dictionary<string, string>> ToRows(object value)
    {
        if (value is System.Text.Json.JsonElement json && json.ValueKind == System.Text.Json.JsonValueKind.Object)
            return json.EnumerateObject().Select(property => new Dictionary<string, string> { ["Metric"] = property.Name, ["Value"] = property.Value.ValueKind == System.Text.Json.JsonValueKind.Array ? $"{property.Value.GetArrayLength()} records" : property.Value.ToString() }).ToList();
        var itemProp = value.GetType().GetProperty("Items");
        var sequence = itemProp?.GetValue(value) as System.Collections.IEnumerable ?? value as System.Collections.IEnumerable;
        var items = sequence is null ? new[] { value } : sequence.Cast<object>().ToArray();
        return items.Select(item => item.GetType().GetProperties().Take(9).ToDictionary(p => p.Name, p => Convert.ToString(p.GetValue(item), System.Globalization.CultureInfo.InvariantCulture) ?? "—")).ToList();
    }

}
