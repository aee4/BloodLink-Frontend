@page "/account/login"
@attribute [AllowAnonymous]
@inject AuthApiClient Auth
@inject NavigationManager Navigation

<PageTitle>Sign in | BloodLink</PageTitle>
<PublicSite>
<main class="bl-auth-page bl-login-page">
    <aside class="bl-auth-aside">
        <PublicBrand Dark="true" />
        <div class="bl-auth-aside-copy">
            <blockquote>Clear information supports better coordination.</blockquote>
            <p>Sign in to manage facility inventory, review requests, and coordinate with authorised teams.</p>
        </div>
        <p class="bl-auth-copyright">BloodLink operations</p>
    </aside>
    <section id="main-content" class="bl-auth-content" aria-labelledby="login-title">
        <div class="bl-auth-panel">
            <PublicBrand Compact="true" />
            <div class="bl-auth-heading"><h1 id="login-title">Sign in</h1><p>Access your facility's BloodLink workspace.</p></div>
            <Feedback Message="@Message" Variant="@Variant" />
            <form class="bl-auth-form" @onsubmit="Submit" @onsubmit:preventDefault>
                <label class="bl-field"><span class="bl-label">Email</span><input class="bl-input" type="email" autocomplete="username" required @bind="Email" /></label>
                <div class="bl-field">
                    <label class="bl-label" for="login-password">Password</label>
                    <div class="bl-login-password-control">
                        <input id="login-password" class="bl-input" type="@(PasswordVisible ? "text" : "password")" autocomplete="current-password" required @bind="Password" />
                        <button class="bl-login-password-toggle" type="button" aria-controls="login-password" aria-label="@(PasswordVisible ? "Hide password" : "Show password")" aria-pressed="@(PasswordVisible ? "true" : "false")" @onclick="() => PasswordVisible = !PasswordVisible">
                            <AppIcon Name="@(PasswordVisible ? "eye-off" : "eye")" Size="20" />
                        </button>
                    </div>
                </div>
                <button class="bl-btn bl-btn-primary bl-btn-block" type="submit" disabled="@Busy">@(Busy ? "Signing in…" : "Sign In")</button>
            </form>
            <p class="bl-password-help">Need help accessing your account? Contact your facility administrator.</p>
            <div class="bl-security-note"><AppIcon Name="shield" Size="14" /> Secure facility access</div>
            <div class="bl-login-links"><a class="bl-auth-home-link" href="/facility/register">Register a facility</a><a class="bl-auth-home-link" href="/">Return to home</a></div>
        </div>
    </section>
</main>
</PublicSite>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "signedOut")] public string? SignedOut { get; set; }
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string? Message { get; set; }
    private string Variant { get; set; } = "danger";
    private bool Busy { get; set; }
    private bool PasswordVisible { get; set; }

    protected override void OnParametersSet()
    {
        if (SignedOut == "true") { Message = "You have signed out."; Variant = "success"; }
    }

    private async Task Submit()
    {
        Busy = true;
        Message = null;
        try
        {
            await Auth.Login(Email.Trim(), Password);
            Navigation.NavigateTo(ReturnPath.LocalOrDashboard(ReturnUrl));
        }
        catch (ApiException ex) { Message = ex.Message; }
        finally { Busy = false; Password = ""; }
    }
}
