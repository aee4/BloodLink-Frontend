@page "/account/login"
@attribute [AllowAnonymous]
@inject AuthApiClient Auth
@inject NavigationManager Navigation

<PageTitle>Sign in | BloodLink</PageTitle>
<main class="bl-auth-page">
    <aside class="bl-auth-aside">
        <BloodLinkBrand Dark="true" />
        <div class="bl-auth-aside-copy">
            <blockquote>Better coordination for every unit of blood.</blockquote>
            <p>Facility teams can manage stock, urgent needs and requests from one workspace.</p>
            <div class="bl-auth-stats" aria-label="Network statistics">
                <div><strong>47</strong><span>Facilities</span></div><div><strong>8</strong><span>Blood Types</span></div><div><strong>24/7</strong><span>Network</span></div>
            </div>
        </div>
        <p class="bl-auth-copyright">BloodLink operations</p>
    </aside>
    <section class="bl-auth-content" aria-labelledby="login-title">
        <div class="bl-auth-panel">
            <div class="bl-auth-mobile-brand"><BloodLinkBrand /></div>
            <div class="bl-auth-heading"><h1 id="login-title">Sign in</h1><p>Access your facility's BloodLink workspace.</p></div>
            <Feedback Message="@Message" Variant="@Variant" />
            <form class="bl-auth-form" @onsubmit="Submit" @onsubmit:preventDefault>
                <label class="bl-field"><span class="bl-label">Email</span><input class="bl-input" type="email" autocomplete="username" required @bind="Email" /></label>
                <label class="bl-field"><span class="bl-label">Password</span><input class="bl-input" type="password" autocomplete="current-password" required @bind="Password" /></label>
                <button class="bl-btn bl-btn-primary bl-btn-block" type="submit" disabled="@Busy">@(Busy ? "Signing in…" : "Sign In")</button>
            </form>
            <p>Password recovery is currently unavailable. Contact your facility administrator.</p>
            <div class="bl-security-note"><AppIcon Name="shield" Size="14" /> Secure facility access</div>
            <a class="bl-auth-home-link" href="/facility/register">Register a facility</a>
            <a class="bl-auth-home-link" href="/">Return to home</a>
        </div>
    </section>
</main>

@code {
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    [SupplyParameterFromQuery(Name = "signedOut")] public string? SignedOut { get; set; }
    private string Email { get; set; } = "";
    private string Password { get; set; } = "";
    private string? Message { get; set; }
    private string Variant { get; set; } = "danger";
    private bool Busy { get; set; }

    protected override void OnParametersSet()
    {
        if (SignedOut == "true") { Message = "You have signed out."; Variant = "success"; }
    }

    private async Task Submit()
    {
        Busy = true;
        Message = null;
        try
        {
            await Auth.Login(Email.Trim(), Password);
            Navigation.NavigateTo(ReturnPath.LocalOrDashboard(ReturnUrl));
        }
        catch (ApiException ex) { Message = ex.Message; }
        finally { Busy = false; Password = ""; }
    }
}
