@page "/"
@attribute [AllowAnonymous]
@inject SessionStore Session
@inject NavigationManager Navigation

<PageTitle>BloodLink | Blood supply coordination</PageTitle>
<a class="bl-skip-link" href="#main-content">Skip to main content</a>
<PublicHeader />

<main id="main-content" class="bl-public-home">
    <section class="bl-hero" aria-labelledby="hero-title">
        <div class="bl-container bl-hero-grid">
            <div class="bl-hero-content">
                <span class="bl-eyebrow"><span aria-hidden="true"></span>Facility blood supply coordination</span>
                <h1 id="hero-title" class="bl-display">A clearer way to coordinate <span>blood supply.</span></h1>
                <p class="bl-hero-copy">BloodLink gives facility teams a shared place to track inventory, coordinate requests, and respond to changing needs.</p>
                <div class="bl-action-row">
                    <a class="bl-btn bl-btn-danger bl-btn-lg" href="/facility/register">Register your facility <span aria-hidden="true">→</span></a>
                    <a class="bl-btn bl-btn-outline bl-btn-lg" href="/account/login">Facility sign in</a>
                </div>
                <p class="bl-hero-note"><AppIcon Name="shield" Size="16" /> Designed for healthcare facility teams</p>
            </div>
            <figure class="bl-hero-visual">
                <img src="images/bloodlink-lab.webp" width="1200" height="800" fetchpriority="high" alt="A laboratory professional carefully checking a sealed blood unit and its records" />
                <figcaption><span class="bl-visual-mark"><AppIcon Name="droplet" Size="18" Filled="true" /></span><span><strong>Careful handling. Clear coordination.</strong><small>Tools for the people managing blood supply.</small></span></figcaption>
            </figure>
        </div>
    </section>

    <section id="features" class="bl-section bl-features" aria-labelledby="features-title">
        <div class="bl-container">
            <div class="bl-section-heading">
                <span>One shared workspace</span>
                <h2 id="features-title">The details teams need, in one place.</h2>
                <p>Give authorised facility staff a consistent view of stock and requests so they can coordinate with greater clarity.</p>
            </div>
            <div class="bl-feature-grid">
                @foreach (var feature in Features)
                {
                    <article class="bl-feature-card"><span class="bl-card-icon"><AppIcon Name="@feature.Icon" Size="22" /></span><div><h3>@feature.Title</h3><p>@feature.Description</p></div></article>
                }
            </div>
        </div>
    </section>

    <section id="how" class="bl-section bl-how" aria-labelledby="how-title">
        <div class="bl-container">
            <div class="bl-section-heading"><span>How it works</span><h2 id="how-title">A practical flow for facility teams.</h2><p>BloodLink brings routine inventory work and facility-to-facility coordination into a single workflow.</p></div>
            <ol class="bl-how-grid">
                @foreach (var step in Steps)
                {
                    <li class="bl-how-card"><div class="bl-how-number">@step.Number</div><span class="bl-card-icon"><AppIcon Name="@step.Icon" Size="23" /></span><h3>@step.Title</h3><p>@step.Description</p></li>
                }
            </ol>
        </div>
    </section>

    <section class="bl-cta-section" aria-labelledby="cta-title">
        <div class="bl-container bl-cta-inner"><div><span class="bl-cta-kicker">Built for healthcare teams</span><h2 id="cta-title">Bring your facility into the conversation.</h2><p>Create a facility workspace or sign in to continue coordinating.</p></div><div class="bl-action-row"><a class="bl-btn bl-btn-light bl-btn-lg" href="/facility/register">Register facility</a><a class="bl-btn bl-btn-ghost-light bl-btn-lg" href="/account/login">Sign in</a></div></div>
    </section>
</main>
<PublicFooter />

@code {
    private static readonly StepItem[] Steps =
    [
        new("01", "building", "Set up your facility", "Your facility and initial administrator are activated immediately. Sign in right away; a System Administrator can suspend access later if needed."),
        new("02", "package", "Keep stock current", "Record inventory by blood type, quantity, and expiry date."),
        new("03", "network", "Coordinate a need", "Review availability and manage requests with other authorised facilities.")
    ];

    private static readonly FeatureItem[] Features =
    [
        new("package", "Inventory visibility", "Track stock by type, quantity, and expiry date in the facility workspace."),
        new("network", "Facility coordination", "Coordinate blood requests and responses with facilities using BloodLink."),
        new("shield", "Role-based access", "Give staff access based on their responsibilities within the facility."),
        new("file-text", "Activity history", "Review records of inventory changes and request activity.")
    ];

    private sealed record StepItem(string Number, string Icon, string Title, string Description);
    private sealed record FeatureItem(string Icon, string Title, string Description);

    protected override void OnInitialized()
    {
        if (Session.User is not null) Navigation.NavigateTo("/dashboard");
    }
}
