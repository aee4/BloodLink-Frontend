@page "/facility/register"
@page "/facilities/register"
@attribute [AllowAnonymous]
@inject FacilityApiClient Facilities

<PageTitle>Register your facility | BloodLink</PageTitle>
<main class="bl-form-page">
    <div class="bl-form-page-inner">
        <a class="bl-back-link" href="/"><AppIcon Name="arrow-right" Size="14" Class="bl-back-arrow" /> Back to BloodLink</a>
        <section class="bl-form-card" aria-labelledby="register-title">
            @if (Submitted is not null)
            {
                <div class="bl-success-card">
                    <span class="bl-success-icon"><AppIcon Name="circle-check" Size="25" /></span>
                    <h1 id="register-title">Registration received</h1>
                    @if (Submitted.Status == FacilityStatus.Approved)
                    { <p>This facility is approved and ready to use. Sign in with the administrator account you created.</p> }
                    else
                    { <p>Your facility is pending approval. You can sign in after a System Admin reviews the registration.</p> }
                    <a class="bl-btn bl-btn-primary bl-btn-lg" href="/account/login">Continue to sign in</a>
                </div>
            }
            else
            {
                <div class="bl-form-card-heading">
                    <span class="bl-form-logo"><AppIcon Name="droplet" Size="21" Filled="true" /></span>
                    <h1 id="register-title">Register your facility</h1>
                    <p>Join the BloodLink network. Facility and administrator details will be reviewed by the BloodLink team.</p>
                </div>
                <Feedback Message="@Message" />
                <form class="bl-form-grid" @onsubmit="Submit" @onsubmit:preventDefault>
                    <fieldset class="bl-fieldset bl-field-full">
                        <legend>Facility details</legend>
                        <div class="bl-form-grid">
                            <label class="bl-field"><span class="bl-label">Facility name <span>*</span></span><input class="bl-input" required maxlength="200" @bind="Form.Name" /></label>
                            <label class="bl-field"><span class="bl-label">Facility type <span>*</span></span><InputSelect class="bl-input bl-select" @bind-Value="Form.FacilityType"><option value="Hospital">Hospital</option><option value="BloodBank">Blood bank</option></InputSelect></label>
                            <label class="bl-field"><span class="bl-label">Registration number <span>*</span></span><input class="bl-input" required maxlength="100" @bind="Form.RegistrationNumber" /></label>
                            <label class="bl-field"><span class="bl-label">Region <span>*</span></span><input class="bl-input" required maxlength="100" @bind="Form.Region" /></label>
                            <label class="bl-field"><span class="bl-label">City <span>*</span></span><input class="bl-input" required maxlength="100" @bind="Form.City" /></label>
                            <label class="bl-field bl-field-full"><span class="bl-label">Address <span>*</span></span><input class="bl-input" required maxlength="500" @bind="Form.Address" /></label>
                            <label class="bl-field"><span class="bl-label">Facility contact email <span>*</span></span><input class="bl-input" type="email" required @bind="Form.ContactEmail" /></label>
                            <label class="bl-field"><span class="bl-label">Facility contact phone <span>*</span></span><input class="bl-input" type="tel" required @bind="Form.ContactPhone" /></label>
                        </div>
                    </fieldset>
                    <fieldset class="bl-fieldset bl-field-full">
                        <legend>Facility administrator</legend>
                        <p class="bl-fieldset-help">This account will manage the facility after approval.</p>
                        <div class="bl-form-grid">
                            <label class="bl-field"><span class="bl-label">First name <span>*</span></span><input class="bl-input" required @bind="Form.AdminFirstName" /></label>
                            <label class="bl-field"><span class="bl-label">Last name <span>*</span></span><input class="bl-input" required @bind="Form.AdminLastName" /></label>
                            <label class="bl-field"><span class="bl-label">Administrator email <span>*</span></span><input class="bl-input" type="email" required @bind="Form.AdminEmail" /></label>
                            <label class="bl-field"><span class="bl-label">Administrator phone <span>*</span></span><input class="bl-input" type="tel" required @bind="Form.AdminPhoneNumber" /></label>
                            <label class="bl-field bl-field-full"><span class="bl-label">Password <span>*</span></span><input class="bl-input" type="password" required autocomplete="new-password" minlength="12" @bind="Form.AdminPassword" aria-describedby="password-requirements" /></label>
                            <p id="password-requirements" class="bl-fieldset-help">Use at least 12 characters and follow the password policy shown by your administrator.</p>
                        </div>
                    </fieldset>
                    <div class="bl-form-actions"><button class="bl-btn bl-btn-danger bl-btn-lg" type="submit" disabled="@Busy">@(Busy ? "Submitting…" : "Submit registration")</button></div>
                </form>
            }
        </section>
    </div>
</main>

@code {
    private RegistrationForm Form { get; set; } = new();
    private FacilityDto? Submitted { get; set; }
    private string? Message { get; set; }
    private bool Busy { get; set; }

    private async Task Submit()
    {
        if (Busy) return;
        Busy = true;
        Message = null;
        try
        {
            Submitted = await Facilities.Register(new(Form.Name, Form.FacilityType, Form.RegistrationNumber, Form.Region, Form.City, Form.Address, Form.ContactEmail, Form.ContactPhone, Form.AdminFirstName, Form.AdminLastName, Form.AdminEmail, Form.AdminPhoneNumber, Form.AdminPassword));
            Form.AdminPassword = "";
        }
        catch (ApiException ex) { Message = ex.Message; }
        finally { Busy = false; }
    }

    private sealed class RegistrationForm
    {
        public string Name { get; set; } = ""; public FacilityType FacilityType { get; set; } public string RegistrationNumber { get; set; } = "";
        public string Region { get; set; } = ""; public string City { get; set; } = ""; public string Address { get; set; } = "";
        public string ContactEmail { get; set; } = ""; public string ContactPhone { get; set; } = ""; public string AdminFirstName { get; set; } = "";
        public string AdminLastName { get; set; } = ""; public string AdminEmail { get; set; } = ""; public string AdminPhoneNumber { get; set; } = "";
        public string AdminPassword { get; set; } = "";
    }
}
