@typeparam TValue
@using System.Linq.Expressions
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

@if (Messages.Count > 0)
{
    <ul id="@Id" class="bl-field-validation" role="alert">
        @foreach (var message in Messages)
        {
            <li>@message</li>
        }
    </ul>
}

@code {
    [CascadingParameter] private EditContext? CurrentEditContext { get; set; }
    [Parameter, EditorRequired] public Expression<Func<TValue>> For { get; set; } = default!;
    [Parameter, EditorRequired] public string Id { get; set; } = "";

    private FieldIdentifier Field { get; set; }
    private IReadOnlyList<string> Messages { get; set; } = [];

    protected override void OnInitialized()
    {
        if (CurrentEditContext is null) throw new InvalidOperationException($"{nameof(InlineValidationMessage<TValue>)} must be inside an EditForm.");
        Field = FieldIdentifier.Create(For);
        CurrentEditContext.OnValidationStateChanged += HandleValidationStateChanged;
        Refresh();
    }

    private void HandleValidationStateChanged(object? sender, ValidationStateChangedEventArgs args)
    {
        Refresh();
        _ = InvokeAsync(StateHasChanged);
    }

    private void Refresh() => Messages = CurrentEditContext!.GetValidationMessages(Field).ToArray();

    public void Dispose()
    {
        if (CurrentEditContext is not null)
            CurrentEditContext.OnValidationStateChanged -= HandleValidationStateChanged;
    }
}
