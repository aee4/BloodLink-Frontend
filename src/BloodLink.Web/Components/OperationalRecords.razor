@using BloodLink.Web.Models

@if (Data is FacilityDto facility)
{
    <section class="bl-card bl-card-pad bl-record-detail" aria-labelledby="record-heading">
        <div class="bl-record-title"><div><p class="bl-eyebrow">Facility</p><h2 id="record-heading">@facility.Name</h2><p>@facility.FacilityType &middot; @facility.City, @facility.Region</p></div><span class="bl-status-badge @FacilityStatusClass(facility.Status)">@FacilityStatusLabel(facility.Status)</span></div>
        <dl class="bl-facts"><div><dt>Registration number</dt><dd>@facility.RegistrationNumber</dd></div><div><dt>Address</dt><dd>@facility.Address</dd></div><div><dt>Contact email</dt><dd>@facility.ContactEmail</dd></div><div><dt>Contact phone</dt><dd>@facility.ContactPhone</dd></div><div><dt>Registered</dt><dd>@facility.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</dd></div>@if (!string.IsNullOrWhiteSpace(facility.RejectionReason)) { <div><dt>Decision note</dt><dd>@facility.RejectionReason</dd></div> }</dl>
    </section>
}
else if (Data is NeedDetailDto need)
{
    <section class="bl-card bl-card-pad bl-record-detail" aria-labelledby="record-heading">
        <div class="bl-record-title"><div><p class="bl-eyebrow">Blood need &middot; @need.FacilityName</p><h2 id="record-heading"><BloodTypeTag Type="need.BloodType" /> &middot; @need.UnitsNeeded units</h2><p>Needed by @need.NeededByUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</p></div><div class="bl-badge-row"><span class="bl-status-badge @StatusClass(need.Urgency.ToString())">@Label(need.Urgency.ToString())</span><span class="bl-status-badge @StatusClass(need.Status.ToString())">@Label(need.Status.ToString())</span></div></div>
        <dl class="bl-facts"><div><dt>Created by</dt><dd>@need.CreatorDisplayName</dd></div><div><dt>Created</dt><dd>@need.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</dd></div>@if (need.InventoryAvailableUnits is int available) { <div><dt>Facility available</dt><dd>@available units</dd></div> }@if (!string.IsNullOrWhiteSpace(need.Note)) { <div><dt>Note</dt><dd>@need.Note</dd></div> }@if (!string.IsNullOrWhiteSpace(need.DecisionReason)) { <div><dt>Decision</dt><dd>@need.DecisionReason</dd></div> }</dl>
    </section>
}
else if (Data is RequestDto request)
{
    <section class="bl-card bl-card-pad bl-record-detail bl-request-detail" aria-labelledby="record-heading">
        <div class="bl-record-title"><div><p class="bl-eyebrow">Blood request</p><h2 id="record-heading"><BloodTypeTag Type="request.BloodType" /> &middot; @request.UnitsRequested units requested</h2></div><span class="bl-status-badge @StatusClass(request.Status.ToString())">@Label(request.Status.ToString())</span></div>
        <dl class="bl-facts">
            <div><dt>Requesting facility</dt><dd>@request.RequestingFacilityName</dd></div><div><dt>Source facility</dt><dd>@request.SourceFacilityName</dd></div><div><dt>Status</dt><dd>@Label(request.Status.ToString())</dd></div><div><dt>Priority</dt><dd>@Label(request.Priority.ToString())</dd></div><div><dt>Units requested</dt><dd>@request.UnitsRequested</dd></div>
            @if (request.UnitsAccepted is int accepted) { <div><dt>@(request.Status == BloodRequestStatus.Fulfilled ? "Units transferred" : "Accepted / reserved units")</dt><dd>@accepted</dd></div> }
            <div><dt>Sent</dt><dd>@request.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</dd></div>
            @if (RequestNeededBy is DateTime neededBy) { <div><dt>Needed by</dt><dd>@neededBy.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</dd></div> }
            @if (!string.IsNullOrWhiteSpace(request.RequestNote)) { <div><dt>Request note</dt><dd>@request.RequestNote</dd></div> }
            @if (!string.IsNullOrWhiteSpace(RequestNeedNote)) { <div><dt>Linked need note</dt><dd>@RequestNeedNote</dd></div> }
            @if (!string.IsNullOrWhiteSpace(request.ResponseNote)) { <div><dt>Response / reason</dt><dd>@request.ResponseNote</dd></div> }
            <div><dt>Source facility available now</dt><dd>@(RequestSourceAvailable?.ToString() ?? "Unavailable") units</dd></div>
            @if (request.Status == BloodRequestStatus.Accepted) { <div><dt>Transferred</dt><dd>No transfer yet; handover has not been confirmed</dd></div> }
            @if (request.Status == BloodRequestStatus.Fulfilled && request.FulfilledAtUtc is DateTime fulfilledAt) { <div><dt>Fulfilled</dt><dd>@fulfilledAt.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</dd></div> }
            <div><dt>Linked need</dt><dd><a href="@($"/needs/{request.BloodNeedId}")">View need details</a></dd></div>
        </dl>
        @if (request.Status == BloodRequestStatus.Accepted) { <p class="bl-alert bl-alert-info" role="status">These units are reserved for this request. Inventory has not been transferred yet.</p> }
    </section>
}
else if (Data is Paged<FacilityDto> facilities)
{
    @if (facilities.Items.Count == 0) { <DashboardEmptyState Title="No facilities in this status" Description="Facilities matching this status will appear here." /> }
    else { <div class="bl-card bl-table-wrap"><table class="bl-table bl-record-table"><thead><tr><th>Facility</th><th>Type</th><th>Location</th><th>Registered</th><th>Status</th><th><span class="visually-hidden">Open</span></th></tr></thead><tbody>@foreach (var item in facilities.Items) { <tr><td data-label="Facility"><a href="@($"/system/facilities/{item.Id}")">@item.Name</a><small class="bl-cell-subtitle">@item.RegistrationNumber</small></td><td data-label="Type">@Label(item.FacilityType.ToString())</td><td data-label="Location">@item.City, @item.Region</td><td data-label="Registered">@item.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td><td data-label="Status"><span class="bl-status-badge @FacilityStatusClass(item.Status)">@FacilityStatusLabel(item.Status)</span></td><td data-label="Action"><a class="bl-icon-button" aria-label="View @item.Name" href="@($"/system/facilities/{item.Id}")"><AppIcon Name="chevron-right" Size="16" /></a></td></tr> }</tbody></table></div> }
    <RecordPager Page="facilities.PageNumber" HasNext="facilities.HasNext" PageChanged="PageChanged" />
}
else if (Data is Paged<StaffDto> staff)
{
    @if (staff.Items.Count == 0) { <DashboardEmptyState Title="No staff accounts yet" Description="Create a staff account to give a colleague access to this facility." /> }
    else { <div class="bl-card bl-table-wrap"><table class="bl-table bl-record-table"><thead><tr><th>Staff member</th><th>Email</th><th>Status</th><th>Created</th><th>Lifecycle</th></tr></thead><tbody>@foreach (var item in staff.Items) { <tr><td data-label="Staff member">@item.FullName</td><td data-label="Email">@item.Email</td><td data-label="Status"><span class="bl-status-badge @StatusClass(item.Status.ToString())">@Label(item.Status.ToString())</span></td><td data-label="Created">@item.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td><td data-label="Lifecycle"><button class="bl-btn bl-btn-outline" @onclick="() => StaffAction.InvokeAsync(item)">@(item.Status == StaffStatus.Active ? "Deactivate" : "Activate")</button></td></tr> }</tbody></table></div> }
    <RecordPager Page="staff.PageNumber" HasNext="staff.HasNext" PageChanged="PageChanged" />
}
else if (Data is IReadOnlyList<InventoryItemDto> inventory)
{
    @if (!IsFacilityAdmin) { <div class="bl-alert bl-alert-info" role="status">View-only inventory. Facility staff can review stock levels; only facility administrators can record adjustments or search the network.</div> }
    <section class="bl-card" aria-labelledby="inventory-table-title"><div class="bl-card-head"><h2 id="inventory-table-title">All blood types</h2></div><div class="bl-table-wrap"><table class="bl-table bl-record-table"><thead><tr><th>Blood type</th><th class="bl-numeric-heading">Total</th><th class="bl-numeric-heading">Reserved</th><th class="bl-numeric-heading">Available</th><th class="bl-numeric-heading">Low threshold</th><th>Status</th><th>Last updated</th>@if (IsFacilityAdmin) { <th>Action</th> }</tr></thead><tbody>
        @foreach (var type in Enum.GetValues<BloodType>())
        {
            var item = inventory.FirstOrDefault(value => value.BloodType == type);
            var available = item?.AvailableUnits ?? 0;
            var threshold = item?.LowStockThreshold ?? 10;
            var low = item is not null && available <= threshold;
            <tr><td data-label="Blood type"><BloodTypeTag Type="type" /></td><td data-label="Total" class="bl-strong">@(item?.TotalUnits ?? 0)</td><td data-label="Reserved">@(item?.ReservedUnits ?? 0)</td><td data-label="Available" class="bl-strong">@available</td><td data-label="Low threshold">@threshold</td><td data-label="Status"><span class="bl-status-badge @(item is null ? "bl-status-neutral" : low ? "bl-status-danger" : "bl-status-success")">@(item is null ? "No stock recorded" : low ? "Low stock" : "Healthy")</span></td><td data-label="Last updated">@(item?.UpdatedAtUtc is DateTime updated ? updated.ToLocalTime().ToString("d MMM yyyy") : "Never")</td>@if (IsFacilityAdmin) { <td data-label="Action"><a class="bl-link" href="@($"/inventory/adjust?bloodType={(int)type}")">Adjust</a></td> }</tr>
        }
        </tbody></table></div></section>
    @if (LowStock.Count > 0) { <div class="bl-alert bl-alert-danger" role="alert"><strong>Low-stock alert</strong><p>@string.Join(", ", LowStock.Select(item => Blood(item.BloodType))) is at or below the minimum threshold.</p></div> }
}
else if (Data is Paged<InventoryTransactionDto> history)
{
    @if (history.Items.Count == 0) { <DashboardEmptyState Title="No inventory activity" Description="Inventory changes will be recorded here." /> }
    else { <div class="bl-card bl-table-wrap"><table class="bl-table bl-record-table"><thead><tr><th>When</th><th>Blood type</th><th class="bl-numeric-heading">Change</th><th class="bl-numeric-heading">Available after</th><th>Reason</th><th>Updated by</th></tr></thead><tbody>@foreach (var item in history.Items) { <tr><td data-label="When">@item.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</td><td data-label="Blood type"><BloodTypeTag Type="item.BloodType" /></td><td data-label="Change">@(item.TotalUnitsChange > 0 ? "+" : "")@item.TotalUnitsChange</td><td data-label="Available after">@(item.TotalAfter - item.ReservedAfter)</td><td data-label="Reason">@item.Reason</td><td data-label="Updated by">@item.ActorDisplayName</td></tr> }</tbody></table></div> }
    <RecordPager Page="history.PageNumber" HasNext="history.HasNext" PageChanged="PageChanged" />
}
else if (Data is Paged<AvailabilityDto> availability)
{
    @if (availability.Items.Count == 0) { <DashboardEmptyState Title="No matching stock found" Description="Try another blood type or lower the minimum available units." /> }
    else { <div class="bl-card bl-table-wrap"><table class="bl-table bl-record-table"><thead><tr><th>Facility</th><th>Type</th><th>Location</th><th>Blood type</th><th class="bl-numeric-heading">Available</th><th>Updated</th></tr></thead><tbody>@foreach (var item in availability.Items) { <tr><td data-label="Facility">@item.FacilityName</td><td data-label="Type">@Label(item.FacilityType.ToString())</td><td data-label="Location">@item.City, @item.Region</td><td data-label="Blood type"><BloodTypeTag Type="item.BloodType" /></td><td data-label="Available"><strong>@item.AvailableUnits</strong></td><td data-label="Updated">@item.UpdatedAtUtc.ToLocalTime().ToString("d MMM, h:mm tt")</td></tr> }</tbody></table></div> }
    <RecordPager Page="availability.PageNumber" HasNext="availability.HasNext" PageChanged="PageChanged" />
}
else if (Data is Paged<NeedDto> needs)
{
    @if (needs.Items.Count == 0) { <DashboardEmptyState Title="No blood needs" Description="New needs will appear here when submitted." /> }
    else { <div class="bl-card bl-table-wrap"><table class="bl-table bl-record-table"><thead><tr><th>Blood type</th><th class="bl-numeric-heading">Units</th><th>Urgency</th><th>Status</th><th>Submitted</th><th>Requested by</th><th class="bl-mobile-field">Needed by</th><th>Action</th></tr></thead><tbody>@foreach (var item in needs.Items) { <tr><td data-label="Blood type"><BloodTypeTag Type="item.BloodType" /></td><td data-label="Units">@item.UnitsNeeded</td><td data-label="Urgency"><span class="bl-status-badge @StatusClass(item.Urgency.ToString())">@Label(item.Urgency.ToString())</span></td><td data-label="Status"><span class="bl-status-badge @StatusClass(item.Status.ToString())">@Label(item.Status.ToString())</span></td><td data-label="Created">@item.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td><td data-label="Requested by">@(item.CreatorDisplayName ?? "Facility staff")</td><td data-label="Needed by" class="bl-mobile-field">@(item.NeededByUtc?.ToLocalTime().ToString("d MMM yyyy, h:mm tt") ?? "See need details")</td><td data-label="Action"><a class="bl-btn bl-btn-outline" href="@($"/needs/{item.Id}")">View details</a></td></tr> }</tbody></table></div> }
    <RecordPager Page="needs.PageNumber" HasNext="needs.HasNext" PageChanged="PageChanged" />
}
else if (Data is Paged<RequestDto> requests)
{
    @if (requests.Items.Count == 0) { <DashboardEmptyState Title="No requests" Description="Requests will appear here as facilities coordinate stock." /> }
    else
    {
        <div class="bl-card bl-table-wrap bl-request-table"><table class="bl-table"><thead><tr><th>Blood type</th><th>@(IsReceivedRequestList ? "Requesting facility" : "Source facility")</th><th class="bl-numeric-heading">Units</th><th>Priority</th><th>Status</th><th>Sent</th><th>Response / reason</th><th>Action</th></tr></thead><tbody>@foreach (var item in requests.Items) { <tr><td><BloodTypeTag Type="item.BloodType" /></td><td>@(IsReceivedRequestList ? item.RequestingFacilityName : item.SourceFacilityName)</td><td>@item.UnitsRequested@(item.UnitsAccepted is int accepted ? $" / {accepted} accepted" : "")</td><td><span class="bl-status-badge @StatusClass(item.Priority.ToString())">@Label(item.Priority.ToString())</span></td><td><span class="bl-status-badge @StatusClass(item.Status.ToString())">@Label(item.Status.ToString())</span></td><td>@item.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</td><td>@(item.Status == BloodRequestStatus.Rejected ? item.ResponseNote ?? "Reason not provided" : item.Status == BloodRequestStatus.Fulfilled ? $"{item.UnitsAccepted ?? 0} units transferred" : item.UnitsAccepted is int acceptedUnits ? $"{acceptedUnits} accepted" : "-")</td><td><a class="bl-btn bl-btn-outline" aria-label="@RequestLinkLabel(item)" href="@($"/requests/{item.Id}")">View request</a></td></tr> }</tbody></table></div>
        <div class="bl-request-cards" aria-label="Requests">
            @foreach (var item in requests.Items)
            {
                <article class="bl-card bl-request-card"><div class="bl-request-card-heading"><BloodTypeTag Type="item.BloodType" /><span class="bl-status-badge @StatusClass(item.Status.ToString())">@Label(item.Status.ToString())</span></div><dl class="bl-request-card-facts"><div><dt>@(IsReceivedRequestList ? "Requesting facility" : "Source facility")</dt><dd>@(IsReceivedRequestList ? item.RequestingFacilityName : item.SourceFacilityName)</dd></div><div><dt>Units requested</dt><dd>@item.UnitsRequested</dd></div><div><dt>@(item.Status == BloodRequestStatus.Fulfilled ? "Transferred" : "Accepted")</dt><dd>@(item.UnitsAccepted?.ToString() ?? "Not accepted") units</dd></div><div><dt>Response / reason</dt><dd>@(item.Status == BloodRequestStatus.Rejected ? item.ResponseNote ?? "Reason not provided" : item.Status == BloodRequestStatus.Fulfilled ? $"{item.UnitsAccepted ?? 0} units transferred" : item.ResponseNote ?? "-")</dd></div><div><dt>Priority</dt><dd>@Label(item.Priority.ToString())</dd></div><div><dt>Sent</dt><dd>@item.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy")</dd></div></dl><a class="bl-btn bl-btn-outline" aria-label="@RequestLinkLabel(item)" href="@($"/requests/{item.Id}")">View request</a></article>
            }
        </div>
    }
}
else if (Data is Paged<NotificationDto> notifications)
{
    @if (notifications.Items.Count == 0) { <DashboardEmptyState Title="You're all caught up" Description="New facility activity and workflow updates will appear here." /> }
    else { <div class="bl-card bl-notification-list">@foreach (var item in notifications.Items) { <article class="bl-notification-row @(item.IsRead ? null : "is-unread")"><span class="bl-notification-icon"><AppIcon Name="@(item.IsRead ? "bell" : "bell-ring")" Size="18" /></span><div class="bl-notification-content"><h2>@item.Title</h2><p>@item.Message</p><time datetime="@item.CreatedAtUtc.ToString("O")">@item.CreatedAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</time>@if (item.RelatedEntityId is Guid related && string.Equals(item.RelatedEntityType, "Need", StringComparison.OrdinalIgnoreCase)) { <a href="@($"/needs/{related}")">View need</a> } else if (item.RelatedEntityId is Guid relatedRequest && string.Equals(item.RelatedEntityType, "Request", StringComparison.OrdinalIgnoreCase)) { <a href="@($"/requests/{relatedRequest}")">View request</a> }</div>@if (!item.IsRead) { <button class="bl-btn bl-btn-outline" @onclick="() => NotificationRead.InvokeAsync(item.Id)">Mark read</button> }</article> }</div> }
    <RecordPager Page="notifications.PageNumber" HasNext="notifications.HasNext" PageChanged="PageChanged" />
}
else if (Data is IReadOnlyList<NeedTimelineDto> needTimeline)
{
    <section class="bl-card bl-card-pad bl-history-card"><h2 class="bl-card-title">Status history</h2><ul class="bl-timeline">@foreach (var item in needTimeline) { <li class="bl-timeline-item"><span class="bl-timeline-dot"></span><div><time class="bl-timeline-time">@item.ChangedAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</time><p class="bl-timeline-event">@Label(item.FromStatus?.ToString() ?? "Created") <span aria-hidden="true">&rarr;</span> @Label(item.ToStatus.ToString()) by @item.ActorDisplayName</p>@if (!string.IsNullOrWhiteSpace(item.Note)) { <p>@item.Note</p> }</div></li> }</ul></section>
}
else if (Data is IReadOnlyList<RequestTimelineDto> requestTimeline)
{
    <section class="bl-card bl-card-pad bl-history-card"><h2 class="bl-card-title">Status history</h2><ul class="bl-timeline">@foreach (var item in requestTimeline) { <li class="bl-timeline-item"><span class="bl-timeline-dot"></span><div><time class="bl-timeline-time">@item.ChangedAtUtc.ToLocalTime().ToString("d MMM yyyy, h:mm tt")</time><p class="bl-timeline-event">@Label(item.FromStatus?.ToString() ?? "Created") <span aria-hidden="true">&rarr;</span> @Label(item.ToStatus.ToString()) by @item.ActorDisplayName</p>@if (!string.IsNullOrWhiteSpace(item.Note)) { <p>@item.Note</p> }</div></li> }</ul></section>
}
else if (Data is not null)
{
    <DashboardEmptyState Title="No records to show" Description="There are no records to display right now." />
}

@code {
    [Parameter, EditorRequired] public object? Data { get; set; }
    [Parameter] public EventCallback<StaffDto> StaffAction { get; set; }
    [Parameter] public EventCallback<Guid> NotificationRead { get; set; }
    [Parameter] public EventCallback<int> PageChanged { get; set; }
    [Parameter] public bool IsFacilityAdmin { get; set; }
    [Parameter] public IReadOnlyList<LowStockDto> LowStock { get; set; } = [];
    [Parameter] public int? RequestSourceAvailable { get; set; }
    [Parameter] public DateTime? RequestNeededBy { get; set; }
    [Parameter] public string? RequestNeedNote { get; set; }
    [Parameter] public bool IsReceivedRequestList { get; set; }

    private static string Blood(BloodType type) => type switch { BloodType.APositive => "A+", BloodType.ANegative => "A-", BloodType.BPositive => "B+", BloodType.BNegative => "B-", BloodType.ABPositive => "AB+", BloodType.ABNegative => "AB-", BloodType.OPositive => "O+", _ => "O-" };
    private string RequestLinkLabel(RequestDto request) => $"View request for {Blood(request.BloodType)}, {request.UnitsRequested} units {(IsReceivedRequestList ? "from" : "at")} {(IsReceivedRequestList ? request.RequestingFacilityName : request.SourceFacilityName)}";
    private static string Label(string value) => System.Text.RegularExpressions.Regex.Replace(value, "(?<=[a-z])([A-Z])", " $1");
    private static string FacilityStatusClass(FacilityStatus status) => status switch { FacilityStatus.Approved => "bl-status-success", FacilityStatus.Suspended or FacilityStatus.Rejected => "bl-status-danger", _ => "bl-status-neutral" };
    private static string FacilityStatusLabel(FacilityStatus status) => status switch { FacilityStatus.Approved => "Active", FacilityStatus.Pending => "Legacy pending", FacilityStatus.Rejected => "Rejected (legacy)", FacilityStatus.Suspended => "Suspended", _ => "Unknown" };
    private static string StatusClass(string value) => value switch { "Approved" or "Active" or "FulfilledInternally" or "FulfilledExternally" or "Accepted" or "Fulfilled" or "Read" => "bl-status-success", "Searching" or "Sent" => "bl-status-info", "Pending" or "PendingReview" or "PendingActivation" or "Urgent" => "bl-status-warning", "Rejected" or "Suspended" or "Inactive" or "Cancelled" or "Emergency" => "bl-status-danger", _ => "bl-status-neutral" };

}
