@inject NavigationManager Navigation

<p class="bl-state" role="status">Taking you to sign in…</p>

@code {
    protected override void OnInitialized()
    {
        var current = "/" + Navigation.ToBaseRelativePath(Navigation.Uri);
        var safe = ReturnPath.IsLocal(current) ? current : "/dashboard";
        Navigation.NavigateTo($"/account/login?returnUrl={Uri.EscapeDataString(safe)}");
    }
}
