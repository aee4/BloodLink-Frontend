        case "arrow-right": <path d="M5 12h14m-7-7 7 7-7 7" /> break;
        case "menu": <path d="M4 6h16M4 12h16M4 18h16" /> break;
        case "x": <path d="m18 6-12 12M6 6l12 12" /> break;
        case "package": <path d="m7.5 4.27 9 5.15M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16ZM3.3 7l8.7 5 8.7-5M12 22V12" /> break;
        case "network": <rect x="16" y="16" width="6" height="6" rx="1" /><rect x="2" y="16" width="6" height="6" rx="1" /><rect x="9" y="2" width="6" height="6" rx="1" /><path d="M5 16v-3a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v3M12 12V8" /> break;
        case "shield": <path d="M20 13c0 5-3.5 7.5-8 9-4.5-1.5-8-4-8-9V5l8-3 8 3z" /> break;
        case "bell": <path d="M10.27 21a2 2 0 0 0 3.46 0M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33" /> break;
        case "file-text": <path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2zM14 2v6h6M8 13h8M8 17h8" /> break;
        case "zap": <path d="M4 14a1 1 0 0 1-.78-1.63l9-11a.5.5 0 0 1 .87.42l-1.67 6.68A1 1 0 0 0 12.39 10H20a1 1 0 0 1 .78 1.63l-9 11a.5.5 0 0 1-.87-.42l1.67-6.68A1 1 0 0 0 11.61 14z" /> break;
        case "mail": <rect width="20" height="16" x="2" y="4" rx="2" /><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7" /> break;
        case "phone": <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6A19.79 19.79 0 0 1 2.12 4.18 2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z" /> break;
        case "circle-check": <path d="M21.8 10a10 10 0 1 1-4.8-6.67M9 11l3 3L22 4" /> break;
        case "activity": <path d="M22 12h-4l-3 9L9 3l-3 9H2" /> break;
        case "alert-triangle": <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 20h16a2 2 0 0 0 1.73-2M12 9v4M12 17h.01" /> break;
        case "check": <path d="m20 6-11 11-5-5" /> break;
        case "chevron-right": <path d="m9 18 6-6-6-6" /> break;
        case "clipboard-list": <rect x="8" y="2" width="8" height="4" rx="1" /><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2M12 11h4M12 16h4M8 11h.01M8 16h.01" /> break;
        case "clock": <circle cx="12" cy="12" r="10" /><path d="M12 6v6l4 2" /> break;
        case "inbox": <path d="M22 12h-6l-2 3h-4l-2-3H2m3.45-6.89A2 2 0 0 1 7.24 4h9.52a2 2 0 0 1 1.79 1.11L22 12v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z" /> break;
        case "send": <path d="m22 2-7 20-4-9-9-4 20-7ZM22 2 11 13" /> break;
        case "search": <circle cx="11" cy="11" r="7" /><path d="m20 20-4-4" /> break;
        case "user": <path d="M20 21a8 8 0 0 0-16 0M12 13a5 5 0 1 0 0-10 5 5 0 0 0 0 10Z" /> break;
        case "log-out": <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9" /> break;
        case "bell-ring": <path d="M10.27 21a2 2 0 0 0 3.46 0M3.26 15.33A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.67C19.41 13.96 18 12.5 18 8A6 6 0 0 0 6 8c0 4.5-1.41 5.96-2.74 7.33ZM2 8a10 10 0 0 1 2-5m18 5a10 10 0 0 0-2-5" /> break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;
    [Parameter] public int Size { get; set; } = 20;
    [Parameter] public bool Filled { get; set; }
    [Parameter] public string? Class { get; set; }
}
