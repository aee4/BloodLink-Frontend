@using BloodLink.Web.Validation

<ul class="bl-password-checklist" aria-label="Password requirements" aria-live="polite">
    <li class="@(Password.Length >= PasswordRules.MinimumLength ? "met" : "")"><span aria-hidden="true">@(Password.Length >= PasswordRules.MinimumLength ? "✓" : "○")</span> At least 8 characters</li>
    <li class="@(PasswordRules.HasUppercase(Password) ? "met" : "")"><span aria-hidden="true">@(PasswordRules.HasUppercase(Password) ? "✓" : "○")</span> One uppercase letter</li>
    <li class="@(PasswordRules.HasLowercase(Password) ? "met" : "")"><span aria-hidden="true">@(PasswordRules.HasLowercase(Password) ? "✓" : "○")</span> One lowercase letter</li>
    <li class="@(PasswordRules.HasDigit(Password) ? "met" : "")"><span aria-hidden="true">@(PasswordRules.HasDigit(Password) ? "✓" : "○")</span> One number</li>
</ul>

@code {
    [Parameter] public string Password { get; set; } = "";
}
