<div class="bl-dash-empty-state" role="status">
    <span aria-hidden="true"><AppIcon Name="@Icon" Size="19" /></span>
    <strong>@Title</strong>
    <p>@Description</p>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Description { get; set; } = string.Empty;
    [Parameter] public string Icon { get; set; } = "inbox";
}
