@inject NavigationManager Navigation
@inject SessionRestoreService SessionRestore
@inject ApplicationInitializationGate Initialization
@inject SessionStore Session

@if (!Initialization.IsInitialized)
{
    <div class="bl-startup-screen" role="status" aria-live="polite" aria-busy="true">
        <span class="bl-startup-spinner" aria-hidden="true"></span>
        <span>Loading BloodLink...</span>
    </div>
}
else
{
    <NavigationLock OnBeforeInternalNavigation="BeforeInternalNavigation" />
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView @key="Navigation.Uri" RouteData="routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        @if (Session.IsLogoutInProgress)
                        {
                            <p class="bl-state" role="status" aria-live="polite">Signing out...</p>
                        }
                        else
                        {
                            <RedirectToLogin />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="routeData" Selector="h1" />
            </Found>
            <NotFound>
                <LayoutView Layout="@typeof(MainLayout)"><NotFoundPage /></LayoutView>
            </NotFound>
        </Router>
    </CascadingAuthenticationState>
}

@code {
    protected override Task OnInitializedAsync() => Initialization.InitializeAsync(() => SessionRestore.RestoreAsync());

    private void BeforeInternalNavigation(LocationChangingContext context)
    {
        if (Session.IsLogoutInProgress)
            context.PreventNavigation();
    }
}
